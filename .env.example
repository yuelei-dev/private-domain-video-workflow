PORT=3000
HOST=127.0.0.1

# 部署在测试服务器时，默认只读扫描该素材库。可显式覆盖，但不要指向生产服务器。
MATERIAL_LIBRARY_ROOT=/home/ubuntu/material-libraries/huangque-media
MATERIAL_LIBRARY_LIMIT=500

# 远程素材 API 应返回 {"items": [...]}，每项可包含 title/name 与 video_url/url/file。
MATERIAL_API_URL=
MATERIAL_FILE_BASE_URL=
MATERIAL_BEARER_TOKEN=

# BGM 与画面素材使用同一个 MATERIAL_LIBRARY_ROOT；工作流只随机读取该目录内的音频文件。
